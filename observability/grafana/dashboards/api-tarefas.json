{
  "uid": "api-tarefas",
  "title": "Monitoramento - API de Tarefas",
  "tags": ["api", "prometheus", "observabilidade"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requisicoes por segundo",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(api_http_requests_total[1m]))",
          "legendFormat": "Requisicoes/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Taxa de erros HTTP",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(api_http_errors_total[1m]))",
          "legendFormat": "Erros/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tempo de resposta p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(api_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Memoria utilizada pelo Node.js",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "decmbytes"},
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "Memoria (MB)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Uso de CPU do processo",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(process_cpu_user_seconds_total[5m])",
          "legendFormat": "CPU (segundos/s)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Estado da API no Prometheus",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "FORA DO AR", "color": "red"},
                "1": {"text": "ONLINE", "color": "green"}
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"api-tarefas\"}",
          "legendFormat": "API",
          "refId": "A"
        }
      ]
    }
  ]
}
